<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.csc311capstone.dashboard.ArcadeShellController" fx:id="root" styleClass="arcade-root" stylesheets="@dashboard/arcade-theme.css" prefWidth="1440" prefHeight="900">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="12" prefWidth="220" minWidth="190">
            <padding>
                <Insets top="24" right="16" bottom="20" left="16"/>
            </padding>
            <HBox fx:id="brand" alignment="CENTER_LEFT" spacing="12"/>
            <Label text="THE CLASSICS. RELOADED." styleClass="tagline"/>
            <Region prefHeight="24"/>
            <Label text="P L A Y" styleClass="eyebrow,muted"/>
            <VBox fx:id="navigation" spacing="8"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox styleClass="info-card" spacing="7">
                <Label text="◌  Always game-ready" styleClass="info-title"/>
                <Label text="8 classic games." styleClass="secondary"/>
                <Label text="Local play is available." styleClass="small,muted"/>
            </VBox>
            <Separator/>
            <Button fx:id="accountButton" onAction="#openAccount" styleClass="account-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox minWidth="0" fx:id="content" spacing="24" fillWidth="true" styleClass="page-content">
                    <padding>
                        <Insets top="25" right="28" bottom="28" left="28"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="pageTitle" styleClass="page-title"/>
                            <Label fx:id="pageDescription" styleClass="secondary" wrapText="true"/>
                        </VBox>
                        <Label text="●  Local arcade ready" styleClass="status-pill"/>
                    </HBox>
                    <StackPane minWidth="0" fx:id="pageHost"/>
                    <HBox>
                        <Label fx:id="breadcrumb" styleClass="small,muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="CSC311  /  ARCADE" styleClass="small,muted"/>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
