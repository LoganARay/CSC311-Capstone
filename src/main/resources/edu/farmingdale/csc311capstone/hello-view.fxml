            prefHeight="500.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.farmingdale.csc311capstone.HelloController">

   <children>
      <Button id="tetris" layoutX="76.0" layoutY="61.0"
              mnemonicParsing="false" prefHeight="91.0"
              prefWidth="143.0" text="Tetris" />

      <Button id="pacman" layoutX="382.0" layoutY="57.0"
