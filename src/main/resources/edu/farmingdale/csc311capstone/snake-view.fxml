<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!--
  The Snake game sits inside an old TV.
  Layers (back to front): dark grass, the game canvas, the TV picture
  (with its screen cut out), the menus, then the CRT effect.
  SnakeController sizes and positions everything to fit the screen, see layoutTv().
-->
<StackPane fx:id="root" style="-fx-background-color: #16181d;"
           xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.farmingdale.csc311capstone.Snake.SnakeController">
    <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/></padding>

    <Pane fx:id="tvPane">
        <Rectangle fx:id="screenGlass" fill="#050805"/>
        <Canvas fx:id="canvas"/>
        <ImageView fx:id="tvImage" mouseTransparent="true" preserveRatio="true" smooth="true"/>
        <VBox fx:id="menuBox" alignment="CENTER" spacing="8.0" visible="false"/>
        <!-- The CRT effect sits on top of everything on the screen. Clicks pass through it. -->
        <Pane fx:id="crtLayer" mouseTransparent="true">
            <Canvas fx:id="crtStatic" visible="false"/>
            <Canvas fx:id="crtGlass"/>
            <Rectangle fx:id="crtRollBar"/>
        </Pane>
    </Pane>
</StackPane>
