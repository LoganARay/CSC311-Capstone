<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" style="-fx-background-color: #10151d;"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.farmingdale.csc311capstone.Snake.SnakeController">

    <top>
        <VBox spacing="6.0">
            <padding><Insets bottom="8.0" left="14.0" right="14.0" top="10.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button focusTraversable="false" onAction="#onMainMenu" text="Main Menu"/>
                <Label text="Mode:" textFill="WHITE"/>
                <ComboBox fx:id="modeBox" prefWidth="150.0"/>
                <Button focusTraversable="false" onAction="#onNewGame" text="New Game"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="infoLabel" textFill="#cfd8e3"/>
                <Label fx:id="bestLabel" textFill="#cfd8e3"/>
                <Label fx:id="scoreLabel" textFill="#7CFC8A">
                    <font><Font name="System Bold" size="18.0"/></font>
                </Label>
            </HBox>
            <Label fx:id="modeDescriptionLabel" maxWidth="624.0" textFill="#9aa7b8" wrapText="true"/>
        </VBox>
    </top>

    <center>
        <StackPane>
            <padding><Insets left="14.0" right="14.0"/></padding>
            <Canvas fx:id="canvas" height="520.0" width="624.0"/>
        </StackPane>
    </center>

    <bottom>
        <Label text="Arrows / WASD: steer    Space: pause    Enter: restart" textFill="#6c7a8c">
            <padding><Insets bottom="10.0" left="14.0" top="8.0"/></padding>
        </Label>
    </bottom>
</BorderPane>
